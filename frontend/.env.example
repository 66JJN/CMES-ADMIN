# ==========================================
# CMES-ADMIN Frontend — Environment Variables
# ==========================================
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# cp .env.example .env

# Admin Backend API + Realtime (Socket.IO อยู่ server เดียวกัน)
REACT_APP_API_URL=http://localhost:5001
REACT_APP_REALTIME_URL=http://localhost:5001

# User Backend API (สำหรับดึงข้อมูล user)
REACT_APP_USER_API_URL=http://localhost:5002

# User Frontend URL (สำหรับสร้าง QR Code / Copy Link ให้ลูกค้า)
REACT_APP_USER_FRONTEND_URL=http://localhost:3000
