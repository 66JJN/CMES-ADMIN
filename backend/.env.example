# ==========================================
# CMES-ADMIN Backend — Environment Variables
# ==========================================
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# cp .env.example .env

# --- Server ---
PORT=5001
NODE_ENV=development

# --- MongoDB Atlas ---
# สร้าง cluster ฟรีที่ https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cmes-admin

# --- JWT Authentication ---
# สร้าง secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-64-char-random-hex-string

# --- Admin Passwords ---
# ใช้สำหรับตั้งค่ารหัสผ่านเริ่มต้นของระบบ (แนะนำให้ใช้รหัสที่คาดเดายาก)
ADMIN_PASSWORD=your-secure-admin-password
CMS1_PASSWORD=your-secure-cms1-password
CMS2_PASSWORD=your-secure-cms2-password

# --- Frontend URLs (CORS whitelist) ---
# LOCAL:
USER_FRONTEND_URL=http://localhost:3000
ADMIN_FRONTEND_URL=http://localhost:3001
# PRODUCTION:
# USER_FRONTEND_URL=https://your-user-frontend.vercel.app
# ADMIN_FRONTEND_URL=https://your-admin-frontend.vercel.app

# --- Cloudinary (File Storage) ---
# สร้างบัญชีฟรีที่ https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- SightEngine AI Content Moderation ---
# สมัครฟรีที่ https://sightengine.com (Free: 2,000 images/month)
SIGHTENGINE_API_USER=your-api-user
SIGHTENGINE_API_SECRET=your-api-secret

# --- Application Settings ---
EXPECTED_AMOUNT=100
